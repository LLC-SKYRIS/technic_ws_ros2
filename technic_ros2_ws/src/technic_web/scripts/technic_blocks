#!/usr/bin/env python3
"""Blocks programming backend (ROS 1 technic_blocks node on ROS 2).

Runs the Python generated by the blocks page (/technic_blocks/) in a thread of
this node; the program talks to the drone through technic_blocks.api.

Services (node "technic_blocks"):
  ~/run         technic_web/srv/Run      run a program
  ~/stop        std_srvs/srv/Trigger     stop it (the drone keeps its last command)
  ~/load        technic_web/srv/Load     examples + user programs
  ~/store       technic_web/srv/Store    save a user program to programs_dir
  ~/get_config  std_srvs/srv/Trigger     page parameters as JSON (ROS 2 has no global params)
Topics:
  ~/running (std_msgs/Bool, latched), ~/block (std_msgs/String, latched),
  ~/print, ~/error (std_msgs/String), ~/prompt (technic_web/msg/Prompt);
  the page answers a prompt on ~/input/<id> (std_msgs/String).
"""

import json
import os
import re
import sys
import threading
import traceback
import uuid

import rclpy
from rclpy.callback_groups import ReentrantCallbackGroup
from rclpy.executors import ExternalShutdownException, MultiThreadedExecutor
from rclpy.node import Node
from rclpy.qos import DurabilityPolicy, QoSProfile, ReliabilityPolicy

from std_msgs.msg import Bool, String
from std_srvs.srv import Trigger
from technic_web.msg import Prompt
from technic_web.srv import Load, Run, Store

from technic_blocks import api

LATCHED = QoSProfile(depth=1, reliability=ReliabilityPolicy.RELIABLE,
                     durability=DurabilityPolicy.TRANSIENT_LOCAL)
NAME_RE = re.compile(r'^[a-zA-Z0-9-_.]{1,40}$')
EXAMPLES = 'examples'


class Blocks(Node):

    def __init__(self):
        super().__init__('technic_blocks')
        self.group = ReentrantCallbackGroup()
        programs_dir = self.declare_parameter('programs_dir', '~/technic_blocks_programs').value
        self.programs_dir = os.path.abspath(os.path.expanduser(programs_dir))
        examples_dir = self.declare_parameter('examples_dir', '').value
        if not examples_dir:
            from ament_index_python.packages import get_package_share_directory
            examples_dir = os.path.join(
                get_package_share_directory('technic_web'), 'technic_blocks', 'programs', EXAMPLES)
        self.examples_dir = examples_dir
        block_period = self.declare_parameter('block_rate', 0.2).value
        # read by the page through ~/get_config; URL parameters override them
        self.config = {
            'navigate_tolerance': self.declare_parameter('navigate_tolerance', 0.2).value,
            'navigate_global_tolerance': self.declare_parameter('navigate_global_tolerance', 1.0).value,
            'yaw_tolerance': self.declare_parameter('yaw_tolerance', 1.0).value,
            'sleep_time': self.declare_parameter('sleep_time', 0.2).value,
            'confirm_run': self.declare_parameter('confirm_run', True).value,
        }

        self.run_lock = threading.Lock()
        self.block = ''
        self.published_block = None

        self.running_pub = self.create_publisher(Bool, '~/running', LATCHED)
        self.block_pub = self.create_publisher(String, '~/block', LATCHED)
        self.print_pub = self.create_publisher(String, '~/print', 10)
        self.error_pub = self.create_publisher(String, '~/error', 10)
        self.prompt_pub = self.create_publisher(Prompt, '~/prompt', 10)
        self.running_pub.publish(Bool(data=False))
        self.block_pub.publish(String(data=''))
        self.create_timer(block_period, self._publish_block, callback_group=self.group)

        for name, srv_type, handler in (
            ('~/run', Run, self._run),
            ('~/stop', Trigger, self._stop),
            ('~/load', Load, self._load),
            ('~/store', Store, self._store),
            ('~/get_config', Trigger, self._get_config),
        ):
            self.create_service(srv_type, name, handler, callback_group=self.group)
        self.get_logger().info('technic_blocks: ready, programs in %s' % self.programs_dir)

    # ------------------------------------------------------------ program helpers

    def _publish_block(self):
        if self.published_block != self.block:
            self.block_pub.publish(String(data=self.block))
            self.published_block = self.block

    def _change_block(self, block):
        """_b(id): called by the program before every block (Blockly STATEMENT_PREFIX)."""
        self.block = block
        api.check_stop()

    def _print(self, *values, **kwargs):
        text = kwargs.get('sep', ' ').join(str(v) for v in values)
        self.get_logger().info('print: %s' % text)
        self.print_pub.publish(String(data=text))

    def _input(self, message=''):
        """input()/raw_input(): ask on the page and wait for the answer (or stop)."""
        prompt_id = 'p' + uuid.uuid4().hex  # a ROS 2 name token must not start with a digit
        answer = []
        event = threading.Event()

        def on_answer(msg):
            answer.append(msg.data)
            event.set()

        sub = self.create_subscription(String, '~/input/' + prompt_id, on_answer, LATCHED,
                                       callback_group=self.group)
        try:
            self.get_logger().info('input: %s' % message)
            self.prompt_pub.publish(Prompt(message=str(message), id=prompt_id))
            while not event.wait(api.POLL):
                api.check_stop()
        finally:
            self.destroy_subscription(sub)
        return answer[0]

    def _program(self, code):
        g = {'__name__': '__main__', '_b': self._change_block, 'print': self._print,
             'input': self._input, 'raw_input': self._input}
        try:
            exec(compile(code, '<program>', 'exec'), g)
        except api.Stop:
            self.get_logger().info('Program stopped')
        except Exception as e:
            self.get_logger().error('Program error: %s' % e)
            etype, value, tb = sys.exc_info()
            frames = traceback.format_exception(etype, value, tb)
            frames.pop(1)  # this file's exec frame
            self.error_pub.publish(String(data='%s\n\n%s' % (e, ''.join(frames))))
        finally:
            # a velocity from set_velocity expires within web_api velocity_valid_for
            api.stop_velocity()
            self.get_logger().info('Program terminated')
            self.block = ''
            self.running_pub.publish(Bool(data=False))
            self.run_lock.release()

    # ------------------------------------------------------------ services

    def _run(self, req, res):
        unsupported = [name for name in api.UNSUPPORTED if re.search(r'\b%s\(' % name, req.code)]
        if unsupported:
            res.success = False
            res.message = 'Not available on ROS 2 yet: ' + '; '.join(
                '%s — %s' % (n, api.UNSUPPORTED[n]) for n in unsupported)
            return res
        try:
            compile(req.code, '<program>', 'exec')
        except SyntaxError as e:
            res.success, res.message = False, 'Syntax error: %s' % e
            return res
        if not self.run_lock.acquire(blocking=False):
            res.success, res.message = False, 'Already running'
            return res
        self.get_logger().info('Run program')
        api.reset_stop()
        self.running_pub.publish(Bool(data=True))
        threading.Thread(target=self._program, args=(req.code,), daemon=True).start()
        res.success = True
        return res

    def _stop(self, req, res):
        self.get_logger().info('Stop program')
        api.request_stop()
        res.success = True
        return res

    def _read_dir(self, directory, prefix, res):
        if not os.path.isdir(directory):
            return
        for current, _, files in sorted(os.walk(directory)):
            for f in sorted(files):
                if f.endswith('.xml'):
                    path = os.path.join(current, f)
                    with open(path) as fp:
                        res.programs.append(fp.read())
                    res.names.append(prefix + os.path.relpath(path, directory))

    def _load(self, req, res):
        try:
            self._read_dir(self.programs_dir, '', res)
            self._read_dir(self.examples_dir, EXAMPLES + '/', res)
        except OSError as e:
            self.get_logger().error(str(e))
            res.success, res.message = False, str(e)
            return res
        res.success = True
        return res

    def _store(self, req, res):
        if not NAME_RE.match(req.name) or not req.name.endswith('.xml'):
            res.success, res.message = False, 'Bad program name (letters, digits, -_. and .xml at the end)'
            return res
        path = os.path.join(self.programs_dir, req.name)
        try:
            os.makedirs(self.programs_dir, exist_ok=True)
            with open(path, 'w') as f:
                f.write(req.program)
        except OSError as e:
            self.get_logger().error(str(e))
            res.success, res.message = False, str(e)
            return res
        res.success, res.message = True, 'Stored to ' + path
        return res

    def _get_config(self, req, res):
        res.success = True
        res.message = json.dumps(self.config)
        return res


def main():
    rclpy.init()
    node = Blocks()
    executor = MultiThreadedExecutor(num_threads=4)
    executor.add_node(node)
    try:
        executor.spin()
    except (KeyboardInterrupt, ExternalShutdownException):
        pass
    finally:
        api.request_stop()
        node.destroy_node()
        rclpy.try_shutdown()


if __name__ == '__main__':
    main()
