#!/usr/bin/env python3
"""Static web server for the Technic pages (ROS 1 roswww / roswww_static).

Serves share/technic_web/www at http://<drone>:<port>/technic/ ("/" redirects
there), /technic/technic_version from /etc/technic_version, and optional extra
directories given as "url_path=directory" in the `mounts` parameter, e.g.
"technic_blocks=/home/orangepi/technic_blocks".
"""

import errno
import functools
import os
import posixpath
import threading
import urllib.parse
from http import HTTPStatus
from http.server import SimpleHTTPRequestHandler, ThreadingHTTPServer

VERSION_FILE = '/etc/technic_version'
RETRY_PERIOD = 5.0  # seconds between attempts to bind a busy port


class Handler(SimpleHTTPRequestHandler):
    """Maps URL prefixes to directories; everything else is 404."""

    def __init__(self, *args, roots=None, default=None, logger=None, **kwargs):
        self.roots = roots          # [(url prefix without slashes, directory)], longest first
        self.default = default
        self.logger = logger
        super().__init__(*args, directory=roots[-1][1], **kwargs)

    def end_headers(self):
        # Pages change with the workspace; do not let phones cache stale copies.
        self.send_header('Cache-Control', 'no-cache')
        super().end_headers()

    def _redirect(self, location):
        self.send_response(HTTPStatus.MOVED_PERMANENTLY)
        self.send_header('Location', location)
        self.send_header('Content-Length', '0')
        self.end_headers()

    def _route(self):
        """Redirect / and bare prefixes; return False when the request is handled."""
        path = urllib.parse.urlsplit(self.path).path
        if path in ('', '/'):
            self._redirect('/' + self.default + '/')
            return False
        for prefix, _ in self.roots:
            if path == '/' + prefix:
                self._redirect(self.path.replace('/' + prefix, '/' + prefix + '/', 1))
                return False
        if path == '/' + self.default + '/technic_version':
            self._send_version()
            return False
        return True

    def _send_version(self):
        try:
            with open(VERSION_FILE, 'rb') as f:
                body = f.read().strip()
        except OSError:
            self.send_error(HTTPStatus.NOT_FOUND)
            return
        self.send_response(HTTPStatus.OK)
        self.send_header('Content-Type', 'text/plain; charset=utf-8')
        self.send_header('Content-Length', str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        if self._route():
            super().do_GET()

    def do_HEAD(self):
        if self._route():
            super().do_HEAD()

    def translate_path(self, path):
        path = urllib.parse.unquote(urllib.parse.urlsplit(path).path)
        parts = [p for p in posixpath.normpath(path).split('/') if p and p not in ('.', '..')]
        for prefix, directory in self.roots:
            prefix_parts = prefix.split('/')
            if parts[:len(prefix_parts)] == prefix_parts:
                return os.path.join(directory, *parts[len(prefix_parts):])
        return os.path.join(os.devnull, 'not-found')

    def log_message(self, fmt, *args):
        if self.logger is not None:
            self.logger.debug('%s %s' % (self.address_string(), fmt % args))


def parse_mounts(www, default, mounts):
    roots = [(default, www)]
    for item in mounts:
        if not item.strip():
            continue
        url, sep, directory = item.partition('=')
        url = url.strip().strip('/')
        directory = os.path.expanduser(directory.strip())
        if not sep or not url or not directory:
            raise ValueError('mount must be "url_path=directory": %r' % item)
        roots.append((url, directory))
    # Longest prefix first, so "technic/docs" wins over "technic".
    return sorted(roots, key=lambda r: len(r[0]), reverse=True)


def make_server(host, port, roots, default, logger=None):
    handler = functools.partial(Handler, roots=roots, default=default, logger=logger)
    ThreadingHTTPServer.allow_reuse_address = True
    server = ThreadingHTTPServer((host, port), handler)
    server.daemon_threads = True
    return server


def main():
    import rclpy
    from ament_index_python.packages import get_package_share_directory
    from rclpy.executors import ExternalShutdownException
    from rclpy.node import Node

    rclpy.init()
    node = Node('web_server')
    host = node.declare_parameter('host', '0.0.0.0').value
    port = node.declare_parameter('port', 8000).value
    default = node.declare_parameter('default', 'technic').value.strip('/')
    www = node.declare_parameter(
        'www', os.path.join(get_package_share_directory('technic_web'), 'www')).value
    mounts = node.declare_parameter('mounts', ['']).value

    roots = parse_mounts(www, default, mounts)
    for prefix, directory in roots:
        if not os.path.isdir(directory):
            node.get_logger().warn('/%s/: directory %s does not exist' % (prefix, directory))
    state = {'server': None, 'warned': False}

    def start():
        """Bind the port; while another process holds it, retry instead of dying."""
        if state['server'] is not None:
            return
        try:
            server = make_server(host, port, roots, default, node.get_logger())
        except OSError as e:
            if e.errno != errno.EADDRINUSE:
                raise
            if not state['warned']:
                node.get_logger().error(
                    'port %d is already in use, retrying every %.0f s. Find the owner: '
                    'sudo ss -ltnp "sport = :%d" (ROS 1 roswww from technic.service? '
                    'a second web.launch.py?) or set web_port:=<other port>'
                    % (port, RETRY_PERIOD, port))
                state['warned'] = True
            return
        state['server'] = server
        threading.Thread(target=server.serve_forever, daemon=True).start()
        node.get_logger().info('Technic web UI: http://%s:%d/%s/' % (host, port, default))
        timer.cancel()

    timer = node.create_timer(RETRY_PERIOD, start)
    start()
    try:
        rclpy.spin(node)
    except (KeyboardInterrupt, ExternalShutdownException):
        pass
    finally:
        if state['server'] is not None:
            state['server'].shutdown()
        node.destroy_node()
        rclpy.try_shutdown()


if __name__ == '__main__':
    main()
