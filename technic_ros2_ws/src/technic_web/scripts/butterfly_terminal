#!/usr/bin/env python3
"""Butterfly web terminal for the "Open Web Terminal" tile (ROS 1 butterfly.service).

Usage: butterfly_terminal [--host 0.0.0.0] [--port 57575] [--login true|false]

Butterfly is not packaged for ROS/apt; install it once with
"pipx install butterfly" (or "pip3 install --user --break-system-packages butterfly").
login true: the terminal asks for the user's login and password (su), as on the
ROS 1 image; login false: a shell without any password for everyone on the network.

The wrapper never exits on its own, so the launch file does not respawn it in a
loop: without butterfly it reports how to install it and waits; while the port is
taken (butterfly.service of an image, another launch) it waits until it is free.
"""

import argparse
import errno
import os
import shutil
import signal
import socket
import time

SERVER = 'butterfly.server.py'
SEARCH_DIRS = ('~/.local/bin', '/usr/local/bin', '/usr/bin')
RETRY_PERIOD = 10.0  # seconds between checks of a busy port


def log(message):
    print('[butterfly_terminal] ' + message, flush=True)


def find_server():
    path = shutil.which(SERVER)
    if path:
        return path
    for directory in SEARCH_DIRS:
        path = os.path.join(os.path.expanduser(directory), SERVER)
        if os.access(path, os.X_OK):
            return path
    return None


def port_is_free(host, port):
    # Without SO_REUSEADDR the check is stricter than tornado's own bind: it also
    # sees a server on a specific address (butterfly.service on 10.42.0.1) when we
    # bind 0.0.0.0. A TIME_WAIT leftover after a restart only delays the start.
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        try:
            s.bind((host, port))
        except OSError as e:
            if e.errno == errno.EADDRINUSE:
                return False
            raise
    return True


def str_to_bool(value):
    return value.strip().lower() in ('1', 'true', 'yes', 'on')


def main():
    parser = argparse.ArgumentParser(description=__doc__.split('\n')[0])
    parser.add_argument('--host', default='0.0.0.0')
    parser.add_argument('--port', type=int, default=57575)
    parser.add_argument('--login', default='true')
    # ros2 launch may append --ros-args ...; ignore them
    args, _ = parser.parse_known_args()

    server = find_server()
    if server is None:
        log('%s not found, the web terminal is disabled. Install it: '
            'pipx install butterfly (or pip3 install --user --break-system-packages butterfly), '
            'or start the launch with butterfly:=false' % SERVER)
        signal.pause()
        return

    warned = False
    while not port_is_free(args.host, args.port):
        if not warned:
            log('port %d is already in use (butterfly.service of the image? another launch?), '
                'waiting for it to be free. Find the owner: sudo ss -ltnp "sport = :%d"'
                % (args.port, args.port))
            warned = True
        time.sleep(RETRY_PERIOD)

    cmd = [server, '--host=' + args.host, '--port=%d' % args.port, '--unsecure']
    if not str_to_bool(args.login):
        cmd.append('--i-hereby-declare-i-dont-want-any-security-whatsoever')
    log('web terminal: http://%s:%d/ (%s)' % (
        args.host, args.port, 'login with the user password' if str_to_bool(args.login) else 'NO password'))
    os.chdir(os.path.expanduser('~'))
    os.execv(server, cmd)


if __name__ == '__main__':
    try:
        main()
    except KeyboardInterrupt:
        pass
