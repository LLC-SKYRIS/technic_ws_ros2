<?xml version="1.0"?>
<package format="3">
  <name>technic_web</name>
  <version>0.1.0</version>
  <description>Technic web UI for ROS 2: static pages, rosbridge, web_video_server and the web API node.</description>

  <maintainer email="support@skyris.pro">Skyris</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <exec_depend>rosidl_default_runtime</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>tf2_ros_py</exec_depend>
  <exec_depend>technic_interfaces</exec_depend>
  <exec_depend>technic_aruco</exec_depend>
  <exec_depend>rosbridge_server</exec_depend>
  <exec_depend>rosapi</exec_depend>
  <exec_depend>web_video_server</exec_depend>
  <exec_depend>rosbag2_py</exec_depend>
  <exec_depend>ros2bag</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>ffmpeg</exec_depend>
  <exec_depend>technic_docs</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
